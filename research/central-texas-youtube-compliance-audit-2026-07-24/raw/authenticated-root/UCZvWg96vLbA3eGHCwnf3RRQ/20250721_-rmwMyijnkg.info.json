 property offers endless potential to create your personal memories. Don’t miss the chance to own your share of Texas!\r\n\r\n2 full bath\r\n\r\nFor more information, please contact: \r\nRobert Herrings\r\nJR Rentals & Property Management\r\n254-547-9994 or robertherringsjr@gmail.com\r\n\r\nYou can also text 154413 to 46835\r\n\r\nAGENT SOCIAL\r\n--------------------\r\nWebsite: http://forthoodrentalproperties.com/\r\nShowcase: https://view.paradym.com/s/Robert-Herrings-JR-Rentals--Property-Management/284510\r\nFacebook: https://www.facebook.com/profile.php?id=100063905801693\r\n\r\nCOMPANY SOCIAL\r\n--------------------\r\nWebsite: https://www.forthoodrealestate.com/\r\nFacebook: https://www.facebook.com/Century21PremierRealtors/\r\nTwitter: https://twitter.com/c21pbroker\r\nLinkedIn: https://www.Linkedin.com/in/hrherrings/\r\nPinterest: https://www.pinterest.com/jrherrings/", "channel_id": "UCZvWg96vLbA3eGHCwnf3RRQ", "channel_url": "https://www.youtube.com/channel/UCZvWg96vLbA3eGHCwnf3RRQ", "duration": 63, "view_count": 1, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=-rmwMyijnkg", "categories": ["Travel & Events"], "tags": ["1341 King Country Road", "76528", "Gatesville TX 76528", "JR Rentals Property Managemen", "Paradym", "Robert Herrings", "Video Tour", "Virtual Tour", "VisualTour", "home for sale", "homes for sale in Gatesville", "real estate"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "channel": "Century 21 Premier Realtors", "channel_follower_count": 8, "uploader": "Century 21 Premier Realtors", "uploader_id": "@century21premierrealtors3", "uploader_url": "https://www.youtube.com/@century21premierrealtors3", "upload_date": "20250721", "timestamp": 1753131304, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtu