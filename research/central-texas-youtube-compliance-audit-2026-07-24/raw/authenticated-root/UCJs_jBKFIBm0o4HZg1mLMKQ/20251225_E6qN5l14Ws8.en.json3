    "segs": [ {
      "utf8": "Yao Ranch. Very functional house. Definitely made \nfor those that are social. And one of the things  "
    } ]
  }, {
    "tStartMs": 6640,
    "dDurationMs": 6560,
    "segs": [ {
      "utf8": "that you're going to love about this two-story \nhouse. So downstairs, primary suite, nice large  "
    } ]
  }, {
    "tStartMs": 13200,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "bathroom. Okay. Standup shower, no tubs. I never \nused a tub anyway. This one does not have one,  "
    } ]
  }, {
    "tStartMs": 20480,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "and I'm actually happy for that. And another cool \nlittle bonus about this place is the fact that it  "
    } ]
  }, {
    "tStartMs": 26720,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "has another bedroom downstairs. So there's another \nbedroom tucked off away from everything over here.  "
    } ]
  }, {
    "tStartMs": 35840,
    "dDurationMs": 8800,
    "segs": [ {
      "utf8": "It also has its own bathroom, but that's not it. \nLarge laundry area, of course. Can't miss that."
    } ]
  } ]
}
