  "events": [ {
    "tStartMs": 160,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "So looking at the way we're seeing home \nprices shift, it's all about the inventory,  "
    } ]
  }, {
    "tStartMs": 5840,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "builders versus sellers, and buyers are in the \nmiddle and really having to decide like which  "
    } ]
  }, {
    "tStartMs": 11600,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "route to go. So for my home buyers, people \nare not accepting those low ball offers.  "
    } ]
  }, {
    "tStartMs": 16320,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "Home sellers are not accepting low ball offers. \nBut if you want to lowball, you need to catch  "
    } ]
  }, {
    "tStartMs": 22720,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "them towards the end of the month, right? Cuz \nthey have another mortgage payment coming up.  "
    } ]
  }, {
    "tStartMs": 27680,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "And when that price cut is coming is typically \ntowards the end of the month or the next month.  "
    } ]
  }, {
    "tStartMs": 33520,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "You don't want to catch a seller right off of \na price cut and then ask for another cut in the  "
    } ]
  }, {
    "tStartMs": 39440,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "price. You're less likely to get it. So if they \nwere going to drop the price by 5,000 or 10,000,  "
    } ]
  }, {
    "tStartMs": 45280,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "you might be able to actually get that 15,000 \noff if you submit that offer before they drop  "
    } ]
  }, {
    "tStartMs": 52080,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "the price. So try to catch them towards the \nend of the month going into the next month  "
    } ]
  }, {
    "tStartMs": 56720,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "right before that mortgage payment is due and \nright before they're going to make that price"
    } ]
  } ]
