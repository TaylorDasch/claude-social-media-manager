    "segs": [ {
      "utf8": "Now, Tremir Estates is on the south side \nof Colleen in between Tremier and 195.  "
    } ]
  }, {
    "tStartMs": 6240,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "It's got some of those kind of early to \nmid 2000s Saratoga and Syntax homes. So,  "
    } ]
  }, {
    "tStartMs": 12960,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "buyers here are getting like newer era \nhomes versus like the older core ones,  "
    } ]
  }, {
    "tStartMs": 18480,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "but still getting a really good price per \nsquare foot. This is a sleeper neighborhood  "
    } ]
  }, {
    "tStartMs": 23920,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "and the homes in this neighborhood tend to sell \npretty fast. That means it's holding value really,  "
