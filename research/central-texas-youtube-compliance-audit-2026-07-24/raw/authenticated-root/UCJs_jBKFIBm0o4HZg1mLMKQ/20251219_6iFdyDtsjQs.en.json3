  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "There were a lot of sales this past year in \nGoodn Night Ranch, some old and some new,  "
    } ]
  }, {
    "tStartMs": 5520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "but the typical build year here is about \n2016. And the median days on market,  "
    } ]
  }, {
    "tStartMs": 10640,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "it's right around 56 days, but that includes \nsome of the newer construction. Now,  "
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "the average price per square foot is a little \nbit higher than the rest of the city at 145,  "
    } ]
  }, {
    "tStartMs": 21280,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "but for that, you're getting something that's \nabout 1,800 square ft, and the median price  "
    } ]
  }, {
    "tStartMs": 26240,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "for this neighborhood is right around 264. \nSo high value without a high price tag."
    } ]
  } ]
}
