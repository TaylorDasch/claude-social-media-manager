  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "You can always price high and leave room to \nnegotiate down. That's a pretty common one. And  "
    } ]
  }, {
    "tStartMs": 5520,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "I don't just hear that from real estate agents. \nI also hear that from the sellers. Here's my  "
    } ]
  }, {
    "tStartMs": 10320,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "quick thought on that one. If you are pricing \nhigh with the thoughts of negotiating down,  "
    } ]
  }, {
    "tStartMs": 15600,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "what you have done is go ahead and put \nyourself in the seat with less leverage.  "
    } ]
  }, {
    "tStartMs": 21520,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "You're losing the negotiation. You're giving \nup the negotiation before it even starts. Look,  "
    } ]
  }, {
    "tStartMs": 26800,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "you don't just want the best price. You want the \nbest terms and the best terms and timeline come  "
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "with leverage. Leverage. And if you're going \nto price high so that somebody can go ahead  "
    } ]
  }, {
    "tStartMs": 38960,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "and negotiate you down, you or that agent is just \nsaying, \"Yeah, I'm going to let them beat me up in  "
    } ]
  }, {
    "tStartMs": 43600,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "the negotiations so I can just walk away with \nthis number.\" Rather than putting yourself in  "
    } ]
  }, {
    "tStartMs": 49280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the position to have the most leverage, which is \ngoing to put you in the position to make the most"
    } ]
  } ]
}
