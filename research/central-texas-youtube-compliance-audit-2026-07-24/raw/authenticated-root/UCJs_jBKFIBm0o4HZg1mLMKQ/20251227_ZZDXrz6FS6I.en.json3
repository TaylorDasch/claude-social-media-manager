  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "you know, Colleen's first master \nplanned community, Gal Ranch,  "
    } ]
  }, {
    "tStartMs": 4400,
    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "is the fact that it is built in 2021, meaning \nit still has the homebuilder's warranty on it,  "
    } ]
  }, {
    "tStartMs": 11760,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "and it still looks pretty new. The \npaint is fresh, the stone looks great,  "
    } ]
  }, {
    "tStartMs": 18400,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "and then also it is not as close \nto some of the other neighbors."
    } ]
  } ]
}
