  "events": [ {
    "tStartMs": 320,
    "dDurationMs": 6800,
    "segs": [ {
      "utf8": "Hire the agent. Okay, this is going to be one of \nthe most pivotal pieces. But if you did everything  "
    } ]
  }, {
    "tStartMs": 7120,
    "dDurationMs": 8080,
    "segs": [ {
      "utf8": "right beforehand, then the agent won't kill this \ndeal for you, right? But I'm only going to go by  "
    } ]
  }, {
    "tStartMs": 15200,
    "dDurationMs": 8720,
    "segs": [ {
      "utf8": "agents who have five star reviews or more. Kind \nof like me. I've got over 90 Google reviews that  "
    } ]
  }, {
    "tStartMs": 23920,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "are five star and I will fight tooth and nail to \nkeep that rate that way. So that's what I'd be  "
    } ]
  }, {
    "tStartMs": 30960,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "looking for in the agent that I hire. I'm going to \nhave them come over, sit down, give me the data,  "
    } ]
  }, {
    "tStartMs": 37360,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "give me the comparables, let me know what \nthey're thinking on price and see if we are  "
    } ]
  }, {
    "tStartMs": 41520,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "in alignment. Also, I'm going to negotiate hard on \nthat commission. I'm going to negotiate hard. Now,  "
    } ]
  }, {
    "tStartMs": 48560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "good agents are going to earn it, and \nif you can show your value as an agent,  "
    } ]
  }, {
    "tStartMs": 52880,
    "dDurationMs": 8640,
    "segs": [ {
      "utf8": "which they should be able to, then it won't be \nas harsh of a negotiation. But I'm determined to  "
    } ]
  }, {
    "tStartMs": 61520,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "make the net that I want to make off of my house. \nThat is the thing that's going to move me. So,  "
    } ]
  }, {
    "tStartMs": 67840,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "I'm going to negotiate tooth to nail with \nthat agent before we ever hit the market  "
    } ]
  }, {
    "tStartMs": 72560,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "so that I can save myself some pennies. \nThat's just me. And if I list your home,  "
    } ]
  }, {
    "tStartMs": 77120,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "we can negotiate back and forth to make \nsure that we get you in a winning position."
    } ]
  } ]
}
