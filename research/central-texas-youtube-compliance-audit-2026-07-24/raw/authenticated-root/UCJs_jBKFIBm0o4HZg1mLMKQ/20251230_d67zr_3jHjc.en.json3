  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Veterans are usually getting into houses \nwith zero money down. And the way to build  "
    } ]
  }, {
    "tStartMs": 4800,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "wealth in the housing market is to pay \ndown the principal over time. You build  "
    } ]
  }, {
    "tStartMs": 9440,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "the equity and hopefully over the course \nof time the home value goes up as well.  "
    } ]
  }, {
    "tStartMs": 15120,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "So when it comes to mortgages, especially the \n30-year, you start paying more interest first,  "
    } ]
  }, {
    "tStartMs": 21360,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "right? Because the investor wants to get their \nmoney back. And it's usually not until like more  "
    } ]
  }, {
    "tStartMs": 26080,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "than halfway through that more money starts \nto go to the principal than to the interest"
    } ]
  } ]
}
