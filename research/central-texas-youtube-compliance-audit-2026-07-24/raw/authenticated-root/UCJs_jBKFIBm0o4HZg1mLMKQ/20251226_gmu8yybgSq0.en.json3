  "events": [ {
    "tStartMs": 80,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "If we're trying to tackle affordability, \nwe're already working in reverse because  "
    } ]
  }, {
    "tStartMs": 4880,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "people have to put more money down to \neven afford a house in the first place,  "
    } ]
  }, {
    "tStartMs": 9200,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "which is a whole other argument for a whole \nother time. But to double tap on veterans here,  "
    } ]
  }, {
    "tStartMs": 14960,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "if you think this is going to help you afford \nmore house, well, you're already working against  "
    } ]
  }, {
    "tStartMs": 20640,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "yourself because your VA benefits won't qualify \nhere. Veterans are usually getting into houses  "
    } ]
  }, {
    "tStartMs": 26160,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "with zero money down. And the way to build wealth \nin the housing market is to pay down the principal  "
    } ]
  }, {
    "tStartMs": 32400,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "over time. You build the equity and hopefully \nover the course of time the home value goes up as"
    } ]
  } ]
}
